---
// Photo frame for a project, 4:3 unless `ratio` says otherwise. With no `src`, draws a sonar placeholder so the slot
// reads as intentional.
interface Props {
  src?: string;
  alt?: string;
  title: string;
  fit?: 'cover' | 'contain';
  ratio?: string; // CSS aspect-ratio, e.g. '16 / 9'
  eager?: boolean;
}
const { src, alt = '', title, fit = 'cover', ratio = '4 / 3', eager = false } = Astro.props;
const mono = title
  .split(/[\s-]+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 3);
---

<figure class="media" style={`aspect-ratio: ${ratio}`}>
  {
    src ? (
      <img
        class:list={[fit]}
        src={src}
        alt={alt}
        width="1200"
        height="900"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="ph" aria-hidden="true">
        <span class="sweep" />
        <span class="blip" />
        <span class="mono">{mono}</span>
        {import.meta.env.DEV && <span class="hint">cover: /projects/…/cover.jpg</span>}
      </div>
    )
  }
</figure>

<style>
  .media {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--surface);
    container-type: inline-size;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  img.contain {
    object-fit: contain;
  }
  .ph {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgb(255 210 122 / 0.12), transparent 20%),
      repeating-radial-gradient(circle at 50% 50%, transparent 0 9cqi, rgb(143 216 255 / 0.08) 9cqi calc(9cqi + 1px)),
      linear-gradient(180deg, #0b2438, #061624);
  }
  /* A sonar arm sweeping round the centre. */
  .sweep {
    position: absolute;
    width: 150cqi;
    aspect-ratio: 1;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background: conic-gradient(from 0deg, rgb(143 216 255 / 0.16), transparent 18%);
    border-radius: 50%;
    animation: sweep 6s linear infinite;
  }
  @keyframes sweep {
    to {
      rotate: 1turn;
    }
  }
  /* A contact on the screen, in lure gold. */
  .blip {
    position: absolute;
    left: 68%;
    top: 32%;
    width: 3cqi;
    min-width: 4px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 3cqi var(--accent);
    animation: blip 6s ease-out infinite;
  }
  @keyframes blip {
    0%,
    100% {
      opacity: 0.25;
    }
    8% {
      opacity: 1;
    }
  }
  .mono {
    position: relative;
    font-family: var(--mono);
    font-size: clamp(0.8rem, 11cqi, 1.8rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(226 240 250 / 0.3);
  }
  .hint {
    position: absolute;
    bottom: 0.5rem;
    left: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    opacity: 0.7;
  }
  @container (max-width: 8rem) {
    .hint {
      display: none;
    }
  }
</style>
