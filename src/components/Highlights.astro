---
// Headline numbers for a project: a big value, what it counts, and its status or source.
interface Props {
  items: { value: string; label: string; note?: string; href?: string }[];
  size?: 'sm' | 'lg';
}
const { items, size = 'sm' } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={['stats', size]} role="list">
      {items.map((h) => (
        <li>
          <span class="v">{h.value}</span>
          <span class="l">{h.label}</span>
          {h.note && (h.href ? <a class="n" href={h.href}>{h.note} ↗</a> : <span class="n">{h.note}</span>)}
        </li>
      ))}
    </ul>
  )
}

<style>
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.8rem 0.65rem;
    border: 1px solid var(--accent-line);
    border-radius: 8px;
    background: var(--accent-soft);
    line-height: 1.3;
  }
  .v {
    font-family: var(--mono);
    font-weight: 650;
    font-size: 1.15rem;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .l {
    font-size: var(--t-small);
    color: var(--ink);
  }
  .n {
    font-size: 0.78rem;
    color: var(--muted);
  }
  a.n {
    position: relative;
    z-index: 1; /* above a card-wide link overlay */
    text-decoration-color: var(--rule-strong);
  }
  a.n:hover {
    color: var(--accent);
  }
  .lg .v {
    font-size: 1.6rem;
  }
  .lg li {
    padding: 0.8rem 1rem 0.85rem;
  }
  /* Small: one-line chips for cards; the status notes live on the detail page. */
  .sm {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sm li {
    flex-direction: row;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }
  .sm .v {
    font-size: var(--t-small);
  }
  .sm .l {
    color: var(--muted);
  }
  .sm .n {
    display: none;
  }
</style>
