---
// Headline numbers for a project, e.g. "3 solo MSRC reports".
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="hl" role="list">
      {items.map((h) => (
        <li>
          <span class="v">{h.value}</span>
          <span class="l">{h.label}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .hl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(255 210 122 / 0.28);
    border-radius: 999px;
    background: rgb(255 210 122 / 0.06);
    font-size: var(--t-small);
    line-height: 1.3;
  }
  .v {
    font-family: var(--mono);
    font-weight: 650;
    color: var(--accent);
  }
  .l {
    color: var(--muted);
  }
</style>
