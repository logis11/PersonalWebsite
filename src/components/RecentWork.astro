---
// Landing-page slider of recent projects and posts. It drifts on its own without end: it slows under the mouse,
// and stops only while a keyboard user is inside it or someone is steering it by hand. Without JS, or with reduced
// motion, it is a plain row that scrolls and snaps by hand.
import ProjectMedia from './ProjectMedia.astro';

export interface Card {
  href: string;
  kind: 'Project' | 'Writing';
  title: string;
  line?: string;
  meta?: string;
  cover?: string;
  coverAlt?: string;
  coverFit?: 'cover' | 'contain';
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---

<section class="recent" aria-labelledby="recent-h">
  <div class="head wrap-inner">
    <h2 id="recent-h">Recent work</h2>
    <div class="ctrl">
      <button type="button" class="prev" aria-label="Scroll back">←</button>
      <button type="button" class="next" aria-label="Scroll forward">→</button>
    </div>
  </div>
  <div class="rail">
    <div class="tracks">
      {
        [0, 1].map((copy) => (
          // The second copy only exists so the drift can loop; JS reveals it, and it is invisible to AT and Tab.
          <ul class="track" role="list" hidden={copy === 1} aria-hidden={copy === 1 ? 'true' : undefined} inert={copy === 1}>
            {cards.map((c) => (
              <li>
                <a class="card" href={c.href} draggable="false">
                  {c.kind === 'Project' ? (
                    <ProjectMedia src={c.cover} alt={c.coverAlt} fit={c.coverFit} title={c.title} ratio="16 / 9" />
                  ) : (
                    <figure class="cover">
                      {c.cover && <img src={c.cover} alt={c.coverAlt ?? ''} width="1280" height="720" loading="lazy" />}
                    </figure>
                  )}
                  <span class:list={['kind', c.kind === 'Project' ? 'gold' : 'cyan']}>{c.kind}</span>
                  <span class="title">{c.title}</span>
                  {c.line && <span class="line">{c.line}</span>}
                  {c.meta && <span class="meta">{c.meta}</span>}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.recent')) {
    const rail = root.querySelector<HTMLElement>('.rail')!;
    const [first, clone] = root.querySelectorAll<HTMLElement>('.track');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cardStep = () => (first.querySelector('li')?.getBoundingClientRect().width ?? 280) + 16;

    // Arrow buttons work in every mode.
    let holdUntil = 0;
    const nudge = (dir: number) => {
      holdUntil = performance.now() + 4000;
      rail.scrollBy({ left: dir * cardStep(), behavior: still ? 'auto' : 'smooth' });
    };
    root.querySelector('.prev')!.addEventListener('click', () => nudge(-1));
    root.querySelector('.next')!.addEventListener('click', () => nudge(1));

    if (!still) {
      clone.hidden = false;
      root.classList.add('drifting');
      // One loop is the first copy plus the gap before the clone; past that the view is identical to 0.
      const loop = () => clone.offsetLeft - first.offsetLeft;
      const SPEED = 48; // px per second
      const HOVER = 0.3; // fraction of SPEED under the mouse, so a card can be read without the row stopping
      let pos = rail.scrollLeft;
      let v = 0; // current speed; eases toward the target so starts and stops don't jerk
      let hovered = false;
      let visible = true;
      let last = performance.now();

      root.addEventListener('pointerenter', (e) => (hovered = e.pointerType === 'mouse'));
      root.addEventListener('pointerleave', () => (hovered = false));
      // Touch and wheel mean the reader is steering; give it back a few seconds after they stop.
      const hold = () => (holdUntil = performance.now() + 3000);
      rail.addEventListener('pointerdown', hold);
      rail.addEventListener('wheel', hold, { passive: true });
      rail.addEventListener('touchmove', hold, { passive: true });
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(rail);

      rail.addEventListener(
        'scroll',
        () => {
          // A scroll we didn't make (swipe, wheel, arrows): follow it, and wrap so it never runs out.
          if (Math.abs(rail.scrollLeft - pos) > 2) {
            pos = rail.scrollLeft;
            const L = loop();
            if (pos >= L) rail.scrollLeft = pos -= L;
            else if (pos <= 0 && L > 0) rail.scrollLeft = pos += L;
          }
        },
        { passive: true },
      );

      const frame = (t: number) => {
        const dt = Math.min(0.05, (t - last) / 1000);
        last = t;
        // Only keyboard focus holds it: a clicked arrow button keeps focus, and must not stop the row for good.
        const held = root.querySelector(':focus-visible') || t < holdUntil || !visible || document.hidden;
        const target = held ? 0 : hovered ? SPEED * HOVER : SPEED;
        v += (target - v) * (1 - Math.exp(-dt * 4));
        if (v > 0.5) {
          // Keep the position as a float; scrollLeft may round to whole pixels and stall a slow drift.
          pos += v * dt;
          const L = loop();
          if (L > 0 && pos >= L) pos -= L;
          rail.scrollLeft = pos;
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .recent {
    /* Break out of the text column so the cards run edge to edge. */
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .wrap-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  h2 {
    margin: 0 0 0.9rem;
    font-size: var(--t-h3);
  }
  .ctrl {
    display: flex;
    gap: 0.4rem;
  }
  .ctrl button {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--glass);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .ctrl button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .rail {
    /* Positioned so the cards paint over the fixed depth gauge instead of under it. */
    position: relative;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: max(var(--gutter), calc(50vw - var(--measure) / 2 + var(--gutter)));
    scrollbar-width: none;
    padding-block: 0.5rem 1.25rem;
    /* Cards fade into the water at both edges. */
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .drifting .rail {
    scroll-snap-type: none;
  }
  .tracks {
    display: flex;
    gap: 1rem;
    width: max-content;
    /* Line the first card up with the text column. */
    padding-inline: max(var(--gutter), calc(50vw - var(--measure) / 2 + var(--gutter)));
  }
  .drifting .tracks {
    padding-inline: 0;
  }
  .track {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .track[hidden] {
    display: none;
  }
  li {
    width: min(17.5rem, 78vw);
    flex: none;
    scroll-snap-align: start;
  }
  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.6rem 0.6rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--glass);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      transform 0.25s;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--accent-line);
    box-shadow: 0 18px 40px -24px var(--glow);
    transform: translateY(-3px);
    text-shadow: none;
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .card :global(.media),
  .cover {
    margin: 0 0 0.45rem;
  }
  .cover {
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kind,
  .title,
  .line,
  .meta {
    padding-inline: 0.35rem;
  }
  .kind {
    align-self: flex-start;
    margin-left: 0.35rem;
    padding: 0 0.5rem;
    border: 1px solid;
    border-radius: 999px;
    font-size: 0.72rem;
    line-height: 1.6;
  }
  .kind.gold {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .kind.cyan {
    border-color: var(--cyan-line);
    color: var(--cyan);
  }
  .title {
    font-weight: 620;
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .line {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .meta {
    margin-top: auto;
    padding-top: 0.3rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
</style>
