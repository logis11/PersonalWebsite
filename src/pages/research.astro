---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchList from '../components/ResearchList.astro';
import { published } from '../lib/util';

const items = (await getCollection('research', published)).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Research" description="Vulnerability disclosures and exploit reproductions.">
  <h1>Research</h1>
  <p class="muted intro">
    Vulnerabilities I have reported, and public bugs I rebuilt end to end from the advisory. Findings still under
    coordinated disclosure are added once the vendor has shipped a fix.
  </p>
  <ResearchList items={items} />
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }
</style>
