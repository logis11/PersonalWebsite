---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
// TODO: this is a first draft. Rewrite the first paragraph in your own words.
---

<Base title="About">
  <h1>About</h1>
  <div class="prose">
    <p>
      I'm Kyungmin Inn, a Computer Engineering student at the University of Michigan. I work on vulnerability research
      and exploitation: memory corruption in userland services, Windows kernel drivers, and embedded and IoT
      firmware.
    </p>
    <p>
      I tend to treat security as computer architecture taken one level further. Reading allocator internals or a
      speculative-execution paper is interesting to me for the same reason: it is the machine's own rules, used in a
      way nobody planned for.
    </p>

    <h2>Now</h2>
    <p>
      On leave from Michigan for independent research after military service in the Republic of Korea Army. Returning
      to Ann Arbor in January 2027.
    </p>

    <h2>Timeline</h2>
    <table class="timeline">
      <thead>
        <tr>
          <th scope="col">Period</th>
          <th scope="col">Where</th>
          <th scope="col">Role</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Oct 2024 – Apr 2026</td>
          <td>Republic of Korea Army</td>
          <td>Satellite Communications Operator, Sergeant (honorable discharge)</td>
        </tr>
        <tr>
          <td>2023 – 2024</td>
          <td>University of Michigan</td>
          <td>B.S.E. Computer Engineering</td>
        </tr>
        <tr>
          <td>2018 – 2023</td>
          <td>Semiahmoo Secondary School, Surrey, BC</td>
          <td>High school</td>
        </tr>
      </tbody>
    </table>

    <h2>Education</h2>
    <p>
      B.S.E. Computer Engineering, University of Michigan, expected 2029.<br />
      <span class="muted">James B. Angell Scholar.</span>
    </p>

    <h2>Competitive programming</h2>
    <p>Baekjoon: solved.ac Platinum (top ~6%)</p>

    {
      SITE.cvUrl && (
        <p>
          <a href={SITE.cvUrl}>Download CV (PDF)</a>
        </p>
      )
    }
  </div>
</Base>

<style>
  .timeline td:first-child {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
</style>
