---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { published, byDateDesc, fmtDate } from '../lib/util';

const posts = (await getCollection('blog', published)).sort(byDateDesc);
---

<Base>
  <h1>{SITE.name}</h1>
  <p class="intro">
    I study how software breaks at the memory level: binary exploitation, Windows kernel drivers, and the firmware
    inside routers, cameras, and the boards on my desk. Computer Engineering at the University of Michigan.{' '}
    {SITE.velog && <>My day-to-day notes, in Korean, are on <a href={SITE.velog}>Velog</a>.</>}
  </p>

  <h2 class="section">Writing</h2>
  {posts.length === 0 && <p class="muted">Nothing published yet.</p>}
  <ul class="posts" role="list">
    {
      posts.map((p) => (
        <li>
          <p class="small muted meta">
            <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
            {p.data.tags.length > 0 && <span>{p.data.tags.join(', ')}</span>}
            {p.data.draft && <span class="draft">draft</span>}
          </p>
          <h3>
            <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          </h3>
          {p.data.summary && <p class="summary">{p.data.summary}</p>}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-bottom: 3rem;
  }
  .section {
    margin: 0 0 1.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts li + li {
    margin-top: 2.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin: 0;
  }
  .draft {
    color: var(--accent);
  }
  h3 {
    margin: 0.1rem 0 0.25rem;
    font-size: 1.2rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }
  h3 a:hover {
    text-decoration-color: currentColor;
  }
  .summary {
    margin: 0;
    color: var(--muted);
  }
</style>
