---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchList from '../components/ResearchList.astro';
import EntryList from '../components/EntryList.astro';
import { SITE } from '../site';
import { published, byDateDesc, byResearch, fmtMonth } from '../lib/util';

const allProjects = (await getCollection('projects', published)).sort((a, b) => a.data.order - b.data.order);
const projects = allProjects.slice(0, 4);
const research = (await getCollection('research', published)).sort(byResearch);
const ctf = (await getCollection('ctf', published)).sort(byDateDesc).slice(0, 4);
const posts = (await getCollection('blog', published)).sort(byDateDesc).slice(0, 4);
// Proof strip: each project's `proof` tiles, then the public CVEs reproduced.
const proof = allProjects.flatMap((p) =>
  p.data.proof.map((t) => ({ ...t, href: t.href ?? `/projects/${p.id}/` })),
);
const cves = research.filter((r) => r.data.cve);
// Split the name into per-letter spans for the entrance animation; the h1 keeps the plain text as its label.
const letters = [...SITE.name];
---

<Base>
  <section class="hero">
    <h1 aria-label={SITE.name}>
      {
        letters.map((ch, i) => (
          <span aria-hidden="true" style={`--i:${i}`}>
            {ch === ' ' ? '\u00a0' : ch}
          </span>
        ))
      }
    </h1>
    <p class="lede">
      I study how software breaks at the memory level: heap corruption in network daemons, Windows kernel drivers,
      and the firmware inside routers and door locks. Computer Engineering at the University of Michigan.
    </p>
    {
      proof.length > 0 && (
        <ul class="proof" role="list">
          {proof.map((t) => (
            <li>
              <a href={t.href}>
                <span class="v">{t.value}</span>
                <span class="l">{t.label}</span>
                {t.note && <span class="n">{t.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      cves.length > 0 && (
        <p class="cves small">
          <span class="muted">1-day reproductions</span>
          {cves.map((r) => (
            <a href={r.data.link ?? '/research/'}>
              {r.data.cve} <span class="muted">{r.data.target}</span>
            </a>
          ))}
        </p>
      )
    }
    <div class="dive" aria-hidden="true"><span></span></div>
  </section>

  <section class="reveal">
    <div class="head">
      <h2>Projects</h2>
      <a class="small" href="/projects/">All projects</a>
    </div>
    <EntryList
      empty="Nothing published yet."
      items={projects.map((p) => ({
        href: `/projects/${p.id}/`,
        title: p.data.title,
        meta: p.data.tagline,
        draft: p.data.draft,
      }))}
    />
  </section>

  <section class="reveal">
    <div class="head">
      <h2>Research</h2>
      <a class="small" href="/research/">All research</a>
    </div>
    <ResearchList items={research} />
  </section>

  <div class:list={['reveal', 'tail', ctf.length > 0 && 'split']}>
    {
      ctf.length > 0 && (
        <section>
          <div class="head">
            <h2>Challenges I wrote</h2>
            <a class="small" href="/ctf/">All</a>
          </div>
          <EntryList
            empty="Nothing published yet."
            items={ctf.map((c) => ({
              href: `/ctf/${c.id}/`,
              title: c.data.title,
              meta: `${c.data.category}, ${c.data.difficulty}`,
              draft: c.data.draft,
            }))}
          />
        </section>
      )
    }
    <section>
      <div class="head">
        <h2>Writing</h2>
        <a class="small" href="/blog/">All</a>
      </div>
      <EntryList
        empty="Nothing published yet."
        items={posts.map((p) => ({
          href: `/blog/${p.id}/`,
          title: p.data.title,
          date: fmtMonth(p.data.date),
          draft: p.data.draft,
        }))}
      />
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3.5rem 0 5.5rem;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: var(--t-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0 0 1.4rem;
    text-shadow: 0 0 40px rgb(120 190 255 / 0.25);
  }
  .hero h1 span {
    display: inline-block;
    animation: surface 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.25s + var(--i) * 55ms);
  }
  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(0.45em) scale(0.96);
      filter: blur(10px);
    }
  }
  .lede {
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 34rem;
    margin: 0;
    color: color-mix(in srgb, var(--ink) 90%, transparent);
    animation: fade 1.4s ease-out 1s both;
  }
  .proof {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.6rem;
    animation: fade 1.4s ease-out 1.3s both;
  }
  .proof a {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid var(--accent-line);
    border-radius: 10px;
    background: rgb(4 17 29 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    text-decoration: none;
    line-height: 1.3;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .proof a:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 30px -18px var(--glow);
    transform: translateY(-2px);
    text-shadow: none;
  }
  .proof .v {
    font-family: var(--mono);
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--accent);
    text-shadow: 0 0 18px var(--glow);
  }
  .proof .l {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .proof .n {
    color: var(--muted-water);
    font-size: 0.78rem;
  }
  .cves {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.5rem;
    margin: 1rem 0 0;
    animation: fade 1.4s ease-out 1.5s both;
  }
  .cves > .muted {
    color: var(--muted-water);
    margin-right: 0.25rem;
  }
  .cves a {
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--cyan-line);
    border-radius: 999px;
    background: rgb(4 17 29 / 0.5);
    color: var(--cyan);
    text-decoration: none;
  }
  .cves a .muted {
    font-family: var(--sans);
    color: var(--muted-water);
  }
  .cves a:hover {
    border-color: var(--cyan);
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .dive {
    position: absolute;
    left: 0;
    bottom: 1.5rem;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(var(--rule), transparent);
    animation: fade 1s ease-out 1.8s both;
  }
  .dive span {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: sink 2.4s ease-in-out infinite;
  }
  @keyframes sink {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translateY(3.3rem);
      opacity: 0;
    }
  }
  /* Sections rise out of the dark as they scroll in. Scroll-driven, so browsers without support, printouts and
     full-page captures simply get the content. */
  @supports (animation-timeline: view()) {
    .reveal {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
  @media print {
    .reveal {
      animation: none;
    }
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .head h2 {
    margin: 0 0 0.8rem;
    font-size: var(--t-h3);
  }
  section + section,
  .tail {
    margin-top: 3.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .split section + section {
    margin-top: 0;
  }
  @media (max-width: 40rem) {
    .split {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
