---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchList from '../components/ResearchList.astro';
import EntryList from '../components/EntryList.astro';
import { SITE } from '../site';
import { published, byDateDesc, fmtMonth } from '../lib/util';

const research = (await getCollection('research', published)).sort((a, b) => b.data.year - a.data.year);
const ctf = (await getCollection('ctf', published)).sort(byDateDesc).slice(0, 4);
const posts = (await getCollection('blog', published)).sort(byDateDesc).slice(0, 4);
// Split the name into per-letter spans for the entrance animation; the h1 keeps the plain text as its label.
const letters = [...SITE.name];
---

<Base>
  <section class="hero">
    <h1 aria-label={SITE.name}>
      {
        letters.map((ch, i) => (
          <span aria-hidden="true" style={`--i:${i}`}>
            {ch === ' ' ? '\u00a0' : ch}
          </span>
        ))
      }
    </h1>
    <p class="lede">
      I study how software breaks at the memory level: heap corruption in network daemons, Windows kernel drivers,
      and the firmware inside routers and door locks. Computer Engineering at the University of Michigan.
    </p>
    <div class="dive" aria-hidden="true"><span></span></div>
  </section>

  <section class="reveal">
    <div class="head">
      <h2>Research</h2>
      <a class="small" href="/research/">All research</a>
    </div>
    <ResearchList items={research} />
  </section>

  <div class="split reveal">
    <section>
      <div class="head">
        <h2>Challenges I wrote</h2>
        <a class="small" href="/ctf/">All</a>
      </div>
      <EntryList
        empty="Nothing published yet."
        items={ctf.map((c) => ({
          href: `/ctf/${c.id}/`,
          title: c.data.title,
          meta: `${c.data.category}, ${c.data.difficulty}`,
          draft: c.data.draft,
        }))}
      />
    </section>
    <section>
      <div class="head">
        <h2>Writing</h2>
        <a class="small" href="/blog/">All</a>
      </div>
      <EntryList
        empty="Nothing published yet."
        items={posts.map((p) => ({
          href: `/blog/${p.id}/`,
          title: p.data.title,
          date: fmtMonth(p.data.date),
          draft: p.data.draft,
        }))}
      />
    </section>
  </div>
</Base>

<script>
  // Fade sections in as they come up from the dark. Hidden only once JS is known to run.
  const items = document.querySelectorAll('.reveal');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 8.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 5rem;
    margin-bottom: 2rem;
  }
  .hero h1 {
    font-size: var(--t-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0 0 1.4rem;
    text-shadow: 0 0 40px rgb(120 190 255 / 0.25);
  }
  .hero h1 span {
    display: inline-block;
    animation: surface 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.25s + var(--i) * 55ms);
  }
  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(0.45em) scale(0.96);
      filter: blur(10px);
    }
  }
  .lede {
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 34rem;
    margin: 0;
    color: color-mix(in srgb, var(--ink) 86%, transparent);
    animation: fade 1.4s ease-out 1s both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .dive {
    position: absolute;
    left: 0;
    bottom: 1.5rem;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(var(--rule), transparent);
    animation: fade 1s ease-out 1.8s both;
  }
  .dive span {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: sink 2.4s ease-in-out infinite;
  }
  @keyframes sink {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translateY(3.3rem);
      opacity: 0;
    }
  }
  :global(.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s ease-out,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.js-reveal) .reveal:global(.is-in) {
    opacity: 1;
    transform: none;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .head h2 {
    margin: 0 0 0.8rem;
    font-size: var(--t-h3);
  }
  section + section,
  .split {
    margin-top: 3.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .split section + section {
    margin-top: 0;
  }
  @media (max-width: 40rem) {
    .split {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
