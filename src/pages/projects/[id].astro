---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Highlights from '../../components/Highlights.astro';
import { published } from '../../lib/util';

export async function getStaticPaths() {
  const all = await getCollection('projects', published);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <p class="small back"><a href="/projects/">Projects</a></p>
  <h1>{d.title}</h1>
  {d.tagline && <p class="tagline">{d.tagline}</p>}
  <p class="small muted meta">
    {d.period}{d.stack.length > 0 && `. ${d.stack.join(', ')}`}
  </p>
  <div class="hl"><Highlights items={d.highlights} size="lg" /></div>
  {
    (d.repo || d.link || d.links.length > 0) && (
      <p class="links">
        {d.repo && <a href={d.repo}>Repository</a>}
        {d.link && <a href={d.link}>Live</a>}
        {d.links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </p>
    )
  }
  {
    (d.cover || import.meta.env.DEV) && (
      <div class="cover">
        <ProjectMedia src={d.cover} alt={d.coverAlt} fit={d.coverFit} title={d.title} eager />
      </div>
    )
  }
  <div class="prose">
    <Content />
  </div>
</Base>

<style>
  .back {
    margin-bottom: 0.75rem;
  }
  h1 {
    margin-bottom: 0.4rem;
  }
  .tagline {
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
    color: var(--accent);
  }
  .meta {
    margin-bottom: 1rem;
  }
  .hl {
    margin-bottom: 1rem;
  }
  .hl:empty {
    display: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.75rem;
  }
  .cover {
    margin-bottom: 2.5rem;
  }
</style>
