---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published } from '../../lib/util';

const projects = (await getCollection('projects', published)).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Tools, systems, and hardware I have built.">
  <h1>Projects</h1>
  <p class="muted intro">Tools, systems, and hardware I have built, mostly for finding or understanding bugs.</p>

  {projects.length === 0 && <p class="muted">Nothing published yet.</p>}
  <ul class="list" role="list">
    {
      projects.map((p) => (
        <li>
          <p class="small muted period">
            {p.data.period}
            {p.data.draft && <span class="draft"> · draft</span>}
          </p>
          <h2>
            <a href={`/projects/${p.id}/`}>{p.data.title}</a>
          </h2>
          {p.data.tagline && <p class="tagline">{p.data.tagline}</p>}
          <p class="summary">{p.data.summary}</p>
          {p.data.stack.length > 0 && <p class="small muted stack">{p.data.stack.join(', ')}</p>}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-bottom: 3rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li + li {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .period {
    margin: 0;
  }
  .draft {
    color: var(--accent);
  }
  h2 {
    margin: 0.1rem 0 0.2rem;
    font-size: 1.25rem;
  }
  h2 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }
  h2 a:hover {
    text-decoration-color: currentColor;
  }
  .tagline {
    margin: 0 0 0.5rem;
  }
  .summary {
    margin: 0;
    color: var(--muted);
  }
  .stack {
    margin: 0.5rem 0 0;
  }
</style>
