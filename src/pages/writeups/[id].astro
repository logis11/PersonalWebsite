---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published, fmtDate } from '../../lib/util';

export async function getStaticPaths() {
  const all = await getCollection('writeups', published);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = [d.cve, d.target, d.event, ...d.tags].filter(Boolean);
---

<Base title={d.title} description={d.summary}>
  <article>
    <p class="small back"><a href="/writeups/">← All writeups</a></p>
    <h1>{d.title}</h1>
    <p class="small muted meta">
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      {meta.length > 0 && <span>{` · ${meta.join(' · ')}`}</span>}
    </p>
    {
      d.links.length > 0 && (
        <p class="links">
          {d.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    margin-bottom: 1rem;
  }
  h1 {
    margin-bottom: 0.3rem;
  }
  .meta {
    margin-bottom: 1.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-bottom: 2rem;
  }
  .prose {
    margin-top: 2rem;
  }
</style>
