---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published, fmtDate } from '../../lib/util';

export async function getStaticPaths() {
  const all = await getCollection('blog', published);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <article>
    <p class="small back"><a href="/blog/">Blog</a></p>
    <h1>{d.title}</h1>
    <p class="small muted meta">
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      {d.tags.length > 0 && <span>, {d.tags.join(', ')}</span>}
      {d.canonical && <span>. <a href={d.canonical}>Originally on Velog</a></span>}
    </p>
    {d.cover && <img class="cover" src={d.cover} alt={d.coverAlt} width="1280" height="720" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    margin-bottom: 0.75rem;
  }
  .meta {
    margin-bottom: 2.5rem;
  }
  .cover {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    margin: -1rem 0 2.5rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
</style>
